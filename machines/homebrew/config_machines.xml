  <machine MACH="homebrew">
    <DESC>

      Customize these fields as appropriate for your system,
      particularly changing MAX_TASKS_PER_NODE and MAX_MPITASKS_PER_NODE to the
      number of cores on your machine.  You may also want to change
      instances of '$ENV{HOME}/projects' to your desired directory
      organization.  You can use this in either of two ways: (1)
      Without making any changes, by adding `--machine homebrew` to
      create_newcase or create_test (2) Copying this into a
      config_machines.xml file in your personal .cime directory and
      then changing the machine name (MACH="homebrew") to
      your machine name and the NODENAME_REGEX to something matching
      your machine's hostname.  With (2), you should not need the
      `--machine` argument, because the machine should be determined
      automatically.

    </DESC>
    <!--  Moved to top level config_machines.xml
        <NODENAME_REGEX> something.matching.your.machine.hostname </NODENAME_REGEX>
        -->

    <OS>Darwin</OS>

    <COMPILERS>gnu</COMPILERS>

    <!-- This configuration supports both openmpi and mpich. If openmpi is present
         (detected by the presence of ompi_info in the user's path) then openmpi is the
         default; if not then mpich is the default. -->
    <MPILIBS>$SHELL{if command -v ompi_info >/dev/null; then echo openmpi,mpich; else echo mpich,openmpi; fi}</MPILIBS>

    <!-- The following paths default to subdirectories of $HOME/projects, but this can be
         overridden by setting $CIME_MACOS_ROOTDIR -->
    <CIME_OUTPUT_ROOT>$SHELL{if [ -n "$CIME_MACOS_ROOTDIR" ]; then echo "$CIME_MACOS_ROOTDIR"; else echo "$HOME/projects"; fi}/scratch</CIME_OUTPUT_ROOT>
    <DIN_LOC_ROOT>$SHELL{if [ -n "$CIME_MACOS_ROOTDIR" ]; then echo "$CIME_MACOS_ROOTDIR"; else echo "$HOME/projects"; fi}/cesm-inputdata</DIN_LOC_ROOT>
    <DIN_LOC_ROOT_CLMFORC>$DIN_LOC_ROOT/atm/datm7</DIN_LOC_ROOT_CLMFORC>
    <DOUT_S_ROOT>$CIME_OUTPUT_ROOT/archive/$CASE</DOUT_S_ROOT>
    <BASELINE_ROOT>$SHELL{if [ -n "$CIME_MACOS_ROOTDIR" ]; then echo "$CIME_MACOS_ROOTDIR"; else echo "$HOME/projects"; fi}/cesm-baselines</BASELINE_ROOT>

    <!-- CIME_MACOS_CPRNC can point to a pre-built cprnc executable. If it isn't set,
         cprnc will be built if needed by a test case. -->
    <CCSM_CPRNC>$SHELL{printenv CIME_MACOS_CPRNC || true}</CCSM_CPRNC>

    <!-- Setting GMAKE to make uses Apple's built-in make tool (in /usr/bin/make) unless
         the user has installed a different version of make in their path. Since Apple's
         make is a version of GNU Make, this should be okay. But this can be changed to
         gmake on a machine that has gmake installed if there are problems with the
         built-in make. -->
    <GMAKE>make</GMAKE>
    <!-- It should be okay to use 8 build threads even on machines with fewer than 8
         cores, but this can be set to a lower value if there are issues such as memory
         problems. -->
    <GMAKE_J>8</GMAKE_J>

    <BATCH_SYSTEM>none</BATCH_SYSTEM>
    <SUPPORTED_BY>cseg</SUPPORTED_BY>

    <!-- Default to 4 tasks, but allow this to be overridden by the CIME_MACOS_NUM_CORES
         environment variable. -->
    <MAX_TASKS_PER_NODE>$SHELL{printenv CIME_MACOS_NUM_CORES || echo 4}</MAX_TASKS_PER_NODE>
    <MAX_MPITASKS_PER_NODE>$SHELL{printenv CIME_MACOS_NUM_CORES || echo 4}</MAX_MPITASKS_PER_NODE>

    <mpirun mpilib="mpich">
      <executable>mpirun</executable>
      <arguments>
        <arg name="anum_tasks"> -np {{ total_tasks }}</arg>
        <arg name="labelstdout">-prepend-rank</arg>
      </arguments>
    </mpirun>
    <mpirun mpilib="openmpi">
      <executable>mpirun</executable>
      <arguments>
        <arg name="anum_tasks"> -np {{ total_tasks }}</arg>
        <arg name="labelstdout">--tag-output</arg>
      </arguments>
    </mpirun>

    <module_system type="none"/>

    <environment_variables>

      <!-- The following variables are taken from environment variables in the user's
           shell. Each variable FOO can be set in one of two ways:

           (1) CIME_MACOS_<COMPILER>_<MPILIB>_FOO, for the case's compiler and MPI
               library, converted to uppercase with hyphens removed. For example:
               CIME_MACOS_GNU_OPENMPI_FOO or CIME_MACOS_GNU_MPISERIAL_FOO.

           (2) FOO itself.

           If both (1) and (2) are set, (1) takes precedence. If neither is set, CIME
           leaves FOO unset.

           These variables are read each time CIME loads the environment (case.setup,
           case.build, case.submit), so keep them consistent for the life of a case.
      -->

      <!-- Path to the esmf.mk file of an ESMF built with the case's compiler and MPI
           library (typically built from source from https://github.com/esmf-org/esmf, or
           installed via conda/spack). -->
      <env name="ESMFMKFILE">$SHELL{printenv CIME_MACOS_$(echo $COMPILER_$MPILIB | tr a-z A-Z | tr -d -)_ESMFMKFILE || printenv ESMFMKFILE || true}</env>

      <!-- These PIO variables are optional but recommended. With them, you can point to a
           pre-built PIO, which should be the same PIO used to build the ESMF library. If
           these are not set, PIO will be built as part of building the model. If any of
           these are set, all of them should be set. -->
      <env name="PIO">$SHELL{printenv CIME_MACOS_$(echo $COMPILER_$MPILIB | tr a-z A-Z | tr -d -)_PIO || printenv PIO || true}</env>
      <env name="PIO_VERSION_MAJOR">$SHELL{printenv CIME_MACOS_$(echo $COMPILER_$MPILIB | tr a-z A-Z | tr -d -)_PIO_VERSION_MAJOR || printenv PIO_VERSION_MAJOR || true}</env>
      <env name="PIO_TYPENAME_VALID_VALUES">$SHELL{printenv CIME_MACOS_$(echo $COMPILER_$MPILIB | tr a-z A-Z | tr -d -)_PIO_TYPENAME_VALID_VALUES || printenv PIO_TYPENAME_VALID_VALUES || true}</env>

      <!-- NETCDF_PATH is only needed if NetCDF is installed outside of the standard
           location for this software stack (e.g., /opt/homebrew/ for a homebrew-based
           setup). -->
      <env name="NETCDF_PATH">$SHELL{printenv CIME_MACOS_$(echo $COMPILER_$MPILIB | tr a-z A-Z | tr -d -)_NETCDF_PATH || printenv NETCDF_PATH || true}</env>

    </environment_variables>
  </machine>
